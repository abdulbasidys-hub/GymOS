# Custom NSIS include, auto-discovered by electron-builder (it looks for
# build/installer.nsh by default — no package.json "nsis.include" entry
# needed).
#
# Why this file exists: the explicit request was that the installer ASK
# whether to keep a desktop shortcut. electron-builder's own
# "createDesktopShortcut" option does not do that — it is a build-time
# policy (always / never / fresh-install-only), with no wizard checkbox
# anywhere in the assisted installer. So the question has to be added as a
# real page here.
#
# The page is inserted through customPageAfterChangeDir, which
# assistedInstaller.nsh places after the install-directory page and before
# the progress page — i.e. the conventional "Additional Tasks" slot, where
# Windows installers normally ask this.
#
# Approach — deliberately "let it create, then remove if declined" rather
# than "only create if accepted": createDesktopShortcut stays TRUE in
# package.json, so electron-builder still creates the shortcut itself and,
# critically, the UNINSTALLER still knows to delete it. Setting that option
# to false would define DO_NOT_CREATE_DESKTOP_SHORTCUT, and uninstaller.nsh
# skips its desktop-shortcut cleanup entirely under that define — a
# shortcut created by hand here would then be orphaned on the desktop after
# an uninstall. customInstall runs after addDesktopLink in installSection.nsh
# (line 81 vs 69), so deleting it there is well-ordered, and $newDesktopLink
# is the same path both electron-builder and the uninstaller use.
#
# IMPORTANT — why the Functions live INSIDE the macro rather than at the
# top level of this file: electron-builder injects this include into a
# generated header that is prepended to its installer.nsi, so it is
# processed BEFORE that file's own `!include "common.nsh"` / `"MUI2.nsh"`.
# Anything at top level here is therefore compiled in a context where
# MUI_HEADER_TEXT and LogicLib conditions like ${isUpdated} do not exist
# yet, and makensis aborts with "Error in macro ... !include: error in
# script ... on line N". A macro body is only expanded where it is
# inserted — assistedInstaller.nsh, well after those includes — so putting
# the page functions in here makes them compile against a fully loaded
# environment. Only `Var` declarations are safe at top level.

# ...and why the whole file is guarded: electron-builder runs makensis
# TWICE, once with -DBUILD_UNINSTALLER for the uninstaller and once for the
# installer, feeding this same include to both. Nothing here belongs to the
# uninstaller (it has its own customUnInstall hook), so on that pass the
# Vars below are declared and never used — and makensis is invoked with
# warnings-as-errors, so "warning 6001: Variable ... not referenced or
# never set" fails the build outright. Guarding the file keeps the
# uninstaller pass completely untouched.
!ifndef BUILD_UNINSTALLER

!include nsDialogs.nsh
!include LogicLib.nsh

Var DesktopShortcutDialog
Var DesktopShortcutCheckbox
Var DesktopShortcutWanted

# electron/builder's assisted installer has NO welcome page of its own —
# assistedInstaller.nsh only inserts one if this macro is defined. Without
# it the wizard opens straight on the install-mode page and the branded
# sidebar (build/installerSidebar.bmp: the mark, "GymOS", and the tagline)
# would only ever appear on the finish page, after the install is over.
# Adding it puts the logo and name in front of the user from the first
# screen, which is the point of having the artwork at all.
#
# The bitmap itself needs no package.json entry: electron-builder resolves
# installerSidebar to build/installerSidebar.bmp by default, and likewise
# uninstallerSidebar.bmp. Both are generated by scripts/make-installer-art.py
# — regenerate them if the logo changes.
#
# MUI_WELCOMEPAGE_* must be defined BEFORE MUI_PAGE_WELCOME is inserted,
# hence the ordering here.
!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Install GymOS"
  !define MUI_WELCOMEPAGE_TEXT "GymOS is the front-desk terminal for your gym — check-ins, plans, payments and reporting, and it keeps working when the internet doesn't.$\r$\n$\r$\nClick Next to continue."
  !insertmacro MUI_PAGE_WELCOME
!macroend

!macro customPageAfterChangeDir
  Page custom desktopShortcutPageShow desktopShortcutPageLeave

  Function desktopShortcutPageShow
    !insertmacro MUI_HEADER_TEXT "Additional Tasks" "Choose what else the installer should set up."

    nsDialogs::Create 1018
    Pop $DesktopShortcutDialog
    ${if} $DesktopShortcutDialog == error
      Abort
    ${endIf}

    ${NSD_CreateLabel} 0 0 100% 24u "Select the additional tasks you would like the installer to perform, then click Next."
    Pop $0

    ${NSD_CreateCheckbox} 0 30u 100% 12u "Create a &desktop shortcut for GymOS"
    Pop $DesktopShortcutCheckbox

    # Pre-ticked, matching both the Windows convention and
    # electron-builder's own default — declining is the deliberate action.
    ${NSD_Check} $DesktopShortcutCheckbox

    nsDialogs::Show
  FunctionEnd

  Function desktopShortcutPageLeave
    ${NSD_GetState} $DesktopShortcutCheckbox $DesktopShortcutWanted
  FunctionEnd
!macroend

!macro customInit
  # Default for every path that never reaches the page — a silent or
  # command-line install. Matches electron-builder's own default (a
  # shortcut is created) so nothing regresses when the page is skipped.
  StrCpy $DesktopShortcutWanted ${BST_CHECKED}
!macroend

!macro customInstall
  ${ifNot} $DesktopShortcutWanted == ${BST_CHECKED}
    WinShell::UninstShortcut "$newDesktopLink"
    Delete "$newDesktopLink"
    System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
  ${endIf}
!macroend

!endif
