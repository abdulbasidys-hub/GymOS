# Copy this file to `.env` and fill in the values from the Firebase console.
# The real `.env` is git-ignored. On Vercel, add these as Environment Variables.
#
# NOTE: these Firebase web values are NOT secrets — they ship to every browser
# by design. Real security comes from Firestore Security Rules, not from hiding
# these. Keeping them in .env is just for clean per-environment config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
